# ============================================================================
# Plataforma de Vídeos Nstech — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# ============================================================================

# --- Banco de dados (PostgreSQL) --------------------------------------------
DATABASE_URL="postgresql://videoapp:CHANGE_ME@localhost:5432/nstech_video?schema=public"

# --- Sessão / autenticação (SPEC §4) ----------------------------------------
# Segredo para assinar o cookie de sessão httpOnly. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_32_bytes_hex"
# Salt para o hash de IP (ipHash = SHA-256(ip + salt)). Gere igual ao de cima.
IP_HASH_SALT="CHANGE_ME_random"

# TTL do AccessToken do espectador, em dias (SPEC §4.1 — padrão 7).
ACCESS_TOKEN_TTL_DAYS="7"
# Duração da sessão do gestor, em horas (SPEC §4.2 — padrão 12).
MANAGER_SESSION_TTL_HOURS="12"
# Duração da sessão do espectador, em dias (SPEC §4.1 — padrão 30).
VIEWER_SESSION_TTL_DAYS="30"

# --- Storage de vídeo (SPEC §7.1 — R2 em prod, disco local em dev) ----------
# Deixe STORAGE_DRIVER=local em desenvolvimento.
STORAGE_DRIVER="local"
# Pasta do storage local (opcional; padrão: ./storage na raiz do projeto).
LOCAL_STORAGE_DIR=""
# Preencher quando STORAGE_DRIVER=r2 (Cloudflare R2, S3-compatible):
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Jobs agendados (SPEC §6.3) ---------------------------------------------
# Segredo do cron de agregação de retenção (Vercel Cron envia como Bearer).
# Em dev pode ficar vazio (a rota fica liberada localmente).
CRON_SECRET=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# E-mail exibido no botão "Pedir novo acesso" (tela de link expirado).
SUPPORT_EMAIL="suporte@nstech.com.br"
