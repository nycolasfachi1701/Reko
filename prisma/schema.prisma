// Plataforma de Vídeos Nstech — modelo de dados (SPEC §5)
// PostgreSQL + Prisma. Agregações de métricas ficam no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MANAGER
  ADMIN
}

enum VideoStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  ARCHIVED
}

enum VoteValue {
  LIKE
  DISLIKE
}

enum TrackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique // todo usuário entra com e-mail+senha; nullable só por compat. de dados legados
  passwordHash String? // hash Argon2id da senha
  role         Role      @default(VIEWER)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?

  // relações
  sessions      Session[]
  videos        Video[] // vídeos que este usuário subiu
  viewSessions  ViewSession[]
  votes         Vote[]
  reactions     Reaction[]
  comments      Comment[]
  createdTracks        Track[] // trilhas que este usuário criou
  assignedTracks       TrackAssignment[] @relation("AssignedTracks")
  trackAssignmentsMade TrackAssignment[] @relation("TrackAssigner")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String
  ipHash    String // SHA-256(ip + salt); nunca o IP em texto puro
  createdAt DateTime @default(now())

  @@index([userId])
}

model Video {
  id                      String      @id @default(cuid())
  title                   String
  description             String      @db.Text
  storageKey              String      // arquivo original enviado
  hlsKey                  String?     // playlist master HLS (quando transcodificado)
  thumbnailUrl            String?
  durationSec             Int
  status                  VideoStatus @default(DRAFT)
  publishedAt             DateTime?
  uploadedById            String
  uploadedBy              User        @relation(fields: [uploadedById], references: [id])
  targetViews             Int? // meta de views (alimenta o bloco Expectativa)
  expectedCompletionRate  Float? // meta de taxa de conclusão (0..1)
  createdAt               DateTime    @default(now())

  tags         VideoTag[]
  viewSessions ViewSession[]
  votes        Vote[]
  reactions    Reaction[]
  comments     Comment[]
  retention    Retention[]
  trackItems   TrackItem[] // aparições deste vídeo em trilhas

  @@index([status, publishedAt])
}

model VideoTag {
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     String

  @@id([videoId, tag])
}

model ViewSession {
  id             String      @id @default(cuid())
  videoId        String
  video          Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime    @default(now())
  lastBeatAt     DateTime    @default(now())
  watchedSeconds Int         @default(0) // tempo real assistido
  maxPositionSec Int         @default(0) // posição mais avançada alcançada
  completed      Boolean     @default(false)
  device         String
  referrer       String?
  heartbeats     Heartbeat[]

  @@index([videoId, startedAt])
  @@index([userId])
}

model Heartbeat {
  id            String      @id @default(cuid())
  viewSessionId String
  viewSession   ViewSession @relation(fields: [viewSessionId], references: [id], onDelete: Cascade)
  positionSec   Int
  at            DateTime    @default(now())

  // Cresce rápido: retido 90 dias, agregado diariamente em Retention.
  @@index([viewSessionId])
  @@index([at])
}

model Retention {
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  bucket  Int // 0..99 — 100 fatias percentuais do vídeo, independente da duração
  viewers Int

  @@id([videoId, bucket])
}

model Vote {
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     VoteValue // exclusivo: um voto por usuário por vídeo
  updatedAt DateTime  @updatedAt

  @@id([videoId, userId])
  @@index([videoId])
}

model Reaction {
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String // cumulativo: o usuário pode marcar vários emojis
  createdAt DateTime @default(now())

  @@id([videoId, userId, emoji])
  @@index([videoId])
}

model Comment {
  videoId  String
  video    Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId String? // um nível de resposta (SPEC §6.2)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")
  body     String    @db.Text
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime? // soft delete: mantém a árvore de respostas de pé

  @@index([videoId, createdAt])
  @@index([parentId])
}

// --- Trilhas (cursos) — Fase T1 -------------------------------------------
// Uma trilha agrupa vídeos em módulos/seções, com ordem livre. Progresso e
// atribuição vêm em fases seguintes (derivados de ViewSession.completed).

model Track {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  coverUrl    String?
  status      TrackStatus @default(DRAFT)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  publishedAt DateTime?

  modules     TrackModule[]
  items       TrackItem[]
  assignments TrackAssignment[]

  @@index([status, publishedAt])
}

model TrackModule {
  id      String @id @default(cuid())
  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title   String
  order   Int    @default(0)

  items TrackItem[]

  @@index([trackId, order])
}

model TrackItem {
  id       String       @id @default(cuid())
  trackId  String
  track    Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  moduleId String? // null = vídeo solto na trilha (fora de módulo)
  module   TrackModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  videoId  String
  video    Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  order    Int          @default(0) // ordem dentro do módulo (ou da trilha, se solto)

  @@unique([trackId, videoId]) // um vídeo não repete na mesma trilha
  @@index([trackId, order])
  @@index([moduleId, order])
}

// Atribuição de trilha a um usuário (obrigatoriedade), com prazo opcional.
// Progresso/conclusão são derivados de ViewSession.completed — sem estado aqui.
model TrackAssignment {
  id           String    @id @default(cuid())
  trackId      String
  track        Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("AssignedTracks", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User      @relation("TrackAssigner", fields: [assignedById], references: [id])
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  @@unique([trackId, userId]) // um usuário é atribuído uma vez por trilha
  @@index([userId])
}
